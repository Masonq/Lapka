# Скопируй в .env и заполни реальными значениями перед деплоем.
# docker-compose.yml подхватывает эти переменные автоматически, если файл называется .env
# и лежит рядом с docker-compose.yml.

# Секрет для подписи JWT-токенов. Сгенерировать: python3 -c "import secrets; print(secrets.token_hex(32))"
# Не оставлять дефолт из docker-compose.yml — иначе любой, кто знает дефолт, подделает токен
JWT_SECRET=

# Токен Telegram-бота для проверки подписи Telegram Login Widget (получить у @BotFather)
TELEGRAM_BOT_TOKEN=

# Домен фронтенда — CORS будет разрешать запросы только с него
ALLOWED_ORIGINS=https://lapa.flatro.app
