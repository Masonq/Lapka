# Аналитика — все три необязательны, каждая подключается независимо только
# если её переменная задана. Не заданы вообще — сайт работает как обычно,
# просто без аналитики. На localhost/127.0.0.1 аналитика не грузится вообще,
# даже если ID заданы — см. analytics.js.
#
# Yandex Metrica — числовой ID счётчика с https://metrika.yandex.ru
# (Создать счётчик → скопировать номер, обычно 7-9 цифр)
VITE_YANDEX_METRICA_ID=

# Google Analytics 4 — Measurement ID вида "G-XXXXXXXXXX"
# с https://analytics.google.com (Admin → Data Streams → твой поток → Measurement ID)
VITE_GA_MEASUREMENT_ID=

# Microsoft Clarity — Project ID с https://clarity.microsoft.com
# (Settings → Overview → Project ID в верху страницы)
VITE_CLARITY_PROJECT_ID=

# Вход через Telegram Login Widget — необязательно, кнопка на экране входа
# показывается только если задано. Требует:
# 1. Создать бота через @BotFather в Telegram, если ещё нет
# 2. Привязать домен к боту командой /setdomain у @BotFather — без этого
#    виджет откажет при попытке авторизации, даже если username указан верно
# 3. Тот же бот должен использовать TELEGRAM_BOT_TOKEN в backend/.env
#    (или docker-compose.yml) — без него backend отклонит любую подпись
VITE_TELEGRAM_BOT_USERNAME=
